<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="AiKvadrober\ConsoleLog\Logger\FrontendLogger">
        <arguments>
            <argument name="name" xsi:type="string">frontend-console</argument>
            <argument name="handlers" xsi:type="array">
                <item name="frontendConsoleHandler" xsi:type="object">AiKvadrober\ConsoleLog\Logger\Handler</item>
            </argument>
        </arguments>
    </type>

    <type name="AiKvadrober\ConsoleLog\Controller\Logger\Save">
        <arguments>
            <argument name="logger" xsi:type="object">AiKvadrober\ConsoleLog\Logger\FrontendLogger</argument>
        </arguments>
    </type>
</config>
